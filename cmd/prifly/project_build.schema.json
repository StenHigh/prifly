{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pri-Fly compiled package provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "algorithm", "author_package", "build_key", "package_profile", "values", "settings", "exclude", "root_ref", "components"],
  "properties": {
    "schema_version": {"const": "prifly-build-provenance/1"},
    "algorithm": {"const": "b1"},
    "author_package": {"$ref": "#/$defs/identity"},
    "build_key": {"$ref": "#/$defs/digest"},
    "package_profile": {"type": "string"},
    "values": {"type": "object"},
    "settings": {"type": "object", "additionalProperties": {"type": "object"}},
    "exclude": {"type": "array", "items": {"type": "string"}},
    "root_ref": {"$ref": "#/$defs/ref"},
    "components": {
      "type": "array", "minItems": 1, "maxItems": 1024,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "author_ref", "compiled_ref", "path"],
        "properties": {
          "kind": {"enum": ["workflow", "step", "check", "schema", "context"]},
          "author_ref": {"$ref": "#/$defs/ref"},
          "compiled_ref": {"$ref": "#/$defs/ref"},
          "path": {"type": "string", "pattern": "^(workflows|steps|checks|schemas|contexts)/[0-9]+\\.(json|txt)$"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$", "maxLength": 64},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}}
    },
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "digest"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "digest": {"$ref": "#/$defs/digest"}}
    }
  }
}
