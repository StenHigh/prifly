{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prifly:execution-bindings:1",
  "$ref": "#/$defs/ExecutionBindings",
  "x-prifly-contracts": ["ExecutionBindings"],
  "$defs": {
    "ExecutionBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "bindings"],
      "properties": {
        "schema_version": {"const": "execution-bindings/1"},
        "bindings": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/ExecutionBinding"}}
      }
    },
    "ExecutionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["definition_ref", "config", "files"],
      "properties": {
        "definition_ref": {"$ref": "#/$defs/ImmutableRef"},
        "config": {"$ref": "#/$defs/ExecutorConfig"},
        "files": {"type": "object", "maxProperties": 256, "additionalProperties": {"type": "string", "contentEncoding": "base64"}}
      }
    },
    "ExecutorConfig": {
      "type": "object", "additionalProperties": false,
      "required": ["executable", "args", "files", "environment", "timeout_ms", "grace_ms", "max_output_bytes"],
      "properties": {
        "executable": {"type": "string", "minLength": 1, "maxLength": 4096},
        "args": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 65536}},
        "files": {"type": "object", "maxProperties": 256, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "environment": {"type": "object", "maxProperties": 128, "additionalProperties": {"type": "string", "maxLength": 65536}},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
        "grace_ms": {"type": "integer", "minimum": 1, "maximum": 5000},
        "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "context_profile_ref": {"$ref": "#/$defs/ImmutableRef"}
      }
    },
    "ImmutableRef": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
