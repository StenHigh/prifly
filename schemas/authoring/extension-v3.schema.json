{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prifly:yaml-authoring:extension:3",
  "title": "Pri-Fly imports, layers and workflow contributions",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "decision_policy": {
          "enum": [
            "attended",
            "autonomous"
          ]
        },
        "preflight": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": true
        },
        "runtime": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": true
        }
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)?$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": true
      }
    },
    "resources": {
      "description": "Exclusive resources of this project: each name with how many attempts of the whole authority may hold it at once (limit, default 1) and the root stages of this workflow whose attempts hold it, including every attempt inside a call such a stage makes. A machine may override the limit in local.yaml. The names are the project's; Pri-Fly reads no meaning into them.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stages"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "references": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "execution_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "executable",
              "timeout_ms",
              "grace_ms",
              "max_output_bytes"
            ],
            "additionalProperties": false,
            "properties": {
              "executable": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "files": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              },
              "grace_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5000
              },
              "max_output_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216
              },
              "live_output": {
                "type": "boolean",
                "description": "Open this program's stdout and stderr to readers of the Run while it works (state 43)."
              },
              "output_limit_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216,
                "description": "Per-stream output limit; absent keeps 64 KiB."
              },
              "context_profile_ref": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "workflow",
              "between",
              "step",
              "on"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "workflow": {
                "type": "string",
                "minLength": 1
              },
              "between": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "step": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)?$"
              },
              "on": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "minProperties": 1
              },
              "impossible_verdicts": {
                "type": "array",
                "items": {
                  "enum": [
                    "pass",
                    "fail",
                    "needs_revision",
                    "no_work"
                  ]
                },
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true
              },
              "input_bindings": {
                "type": "object",
                "maxProperties": 256,
                "propertyNames": {
                  "minLength": 1
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^\\$(?:inputs\\.[^.\\#]+|stages\\.[^.\\#]+\\.[^.\\#]+)(?:#(?:/.*)?)?$"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "from"
                      ],
                      "properties": {
                        "from": {
                          "type": "string",
                          "minLength": 1
                        },
                        "port": {
                          "type": "string",
                          "minLength": 1
                        },
                        "stage_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pointer": {
                          "type": "string"
                        },
                        "schema_ref": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "id",
                                "version",
                                "digest"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "version": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "digest": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          ]
                        },
                        "projected_schema_ref": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "id",
                                "version",
                                "digest"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "version": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "digest": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          ]
                        },
                        "value": {}
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "workflow",
              "between",
              "on",
              "call"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "workflow": {
                "type": "string",
                "minLength": 1
              },
              "between": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "minLength": 1
                  },
                  "to": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "on": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                },
                "minProperties": 1
              },
              "input_bindings": {
                "type": "object",
                "maxProperties": 256,
                "propertyNames": {
                  "minLength": 1
                },
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^\\$(?:inputs\\.[^.\\#]+|stages\\.[^.\\#]+\\.[^.\\#]+)(?:#(?:/.*)?)?$"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "from"
                      ],
                      "properties": {
                        "from": {
                          "type": "string",
                          "minLength": 1
                        },
                        "port": {
                          "type": "string",
                          "minLength": 1
                        },
                        "stage_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "pointer": {
                          "type": "string"
                        },
                        "schema_ref": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "id",
                                "version",
                                "digest"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "version": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "digest": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          ]
                        },
                        "projected_schema_ref": {
                          "oneOf": [
                            {
                              "type": "string",
                              "minLength": 1
                            },
                            {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "id",
                                "version",
                                "digest"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "version": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "digest": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              }
                            }
                          ]
                        },
                        "value": {}
                      }
                    }
                  ]
                }
              },
              "call": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)?$"
              },
              "on_error": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "authoring": {
      "const": "prifly-extension/3"
    },
    "imports": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$"
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "arrange": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "between",
          "on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "between": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "on": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "succeeded",
              "rejected"
            ],
            "properties": {
              "succeeded": {
                "type": "string",
                "minLength": 1
              },
              "rejected": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "on_error": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/member"
            }
          },
          "parallel": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "#/$defs/member"
            }
          },
          "choice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "selection",
              "branches",
              "default",
              "on_unknown"
            ],
            "properties": {
              "selection": {
                "enum": [
                  "first_match",
                  "exclusive"
                ]
              },
              "on_unknown": {
                "const": "rejected"
              },
              "default": {
                "$ref": "#/$defs/member"
              },
              "branches": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "predicate",
                    "use"
                  ],
                  "properties": {
                    "predicate": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object"
                        }
                      ]
                    },
                    "use": {
                      "$ref": "#/$defs/member"
                    }
                  }
                }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "sequence"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parallel"
                  ]
                },
                {
                  "required": [
                    "choice"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "parallel"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sequence"
                  ]
                },
                {
                  "required": [
                    "choice"
                  ]
                }
              ]
            }
          },
          {
            "required": [
              "choice"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "sequence"
                  ]
                },
                {
                  "required": [
                    "parallel"
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "authoring"
  ],
  "$defs": {
    "member": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
        },
        {
          "$ref": "#/$defs/group"
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "parallel": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "choice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection",
            "branches",
            "default",
            "on_unknown"
          ],
          "properties": {
            "selection": {
              "enum": [
                "first_match",
                "exclusive"
              ]
            },
            "on_unknown": {
              "const": "rejected"
            },
            "default": {
              "$ref": "#/$defs/member"
            },
            "branches": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "predicate",
                  "use"
                ],
                "properties": {
                  "predicate": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "use": {
                    "$ref": "#/$defs/member"
                  }
                }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "sequence"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "parallel"
                ]
              },
              {
                "required": [
                  "choice"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "parallel"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sequence"
                ]
              },
              {
                "required": [
                  "choice"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "choice"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "sequence"
                ]
              },
              {
                "required": [
                  "parallel"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
