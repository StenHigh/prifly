{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/Identifier"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "artifact_id",
        "revision",
        "digest"
      ],
      "type": "object"
    },
    "ChoiceDecision": {
      "$ref": "#/$defs/runtime_ChoiceDecision"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "FieldRef": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "const": "workflow_input"
            },
            "pointer": {
              "$ref": "#/$defs/Pointer"
            },
            "port": {
              "$ref": "#/$defs/PortName"
            }
          },
          "required": [
            "from",
            "port"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "from": {
              "const": "stage_output"
            },
            "pointer": {
              "$ref": "#/$defs/Pointer"
            },
            "port": {
              "$ref": "#/$defs/PortName"
            },
            "stage_id": {
              "$ref": "#/$defs/Identifier"
            }
          },
          "required": [
            "from",
            "stage_id",
            "port"
          ],
          "type": "object"
        }
      ]
    },
    "Identifier": {
      "pattern": "^[A-Za-z][A-Za-z0-9._:/-]{0,127}$",
      "type": "string"
    },
    "ImmutableRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "version": {
          "$ref": "#/$defs/Version"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "Pointer": {
      "maxLength": 2048,
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$",
      "type": "string"
    },
    "PortName": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "maxLength": 40,
      "pattern": "Z$",
      "type": "string"
    },
    "Version": {
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$",
      "type": "string"
    },
    "flow_FieldRef": {
      "$ref": "#/$defs/FieldRef"
    },
    "flow_Ref": {
      "$ref": "#/$defs/ImmutableRef"
    },
    "runtime_ArtifactRef": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "runtime_ChoiceDecision": {
      "additionalProperties": false,
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "failure"
                ]
              },
              {
                "required": [
                  "failure_path"
                ]
              }
            ]
          },
          "properties": {
            "route": {
              "const": "branch"
            }
          },
          "required": [
            "branch_id",
            "next_stage_id"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "branch_id"
                ]
              },
              {
                "required": [
                  "failure"
                ]
              },
              {
                "required": [
                  "failure_path"
                ]
              }
            ]
          },
          "properties": {
            "route": {
              "const": "default"
            }
          },
          "required": [
            "next_stage_id"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "branch_id"
                ]
              },
              {
                "required": [
                  "failure"
                ]
              },
              {
                "required": [
                  "failure_path"
                ]
              }
            ]
          },
          "properties": {
            "route": {
              "const": "on_unknown"
            }
          },
          "required": [
            "next_stage_id"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "branch_id"
                ]
              }
            ]
          },
          "properties": {
            "failure": {
              "not": {
                "enum": [
                  "condition_unknown",
                  "no_transition"
                ]
              }
            },
            "route": {
              "const": "on_error"
            }
          },
          "required": [
            "next_stage_id",
            "failure"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "branch_id"
                ]
              },
              {
                "required": [
                  "next_stage_id"
                ]
              }
            ]
          },
          "properties": {
            "route": {
              "const": "failed"
            }
          },
          "required": [
            "failure"
          ]
        }
      ],
      "properties": {
        "branch_id": {
          "$ref": "#/$defs/Identifier"
        },
        "evaluations": {
          "items": {
            "$ref": "#/$defs/runtime_ChoiceEvaluation"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "failure": {
          "$ref": "#/$defs/Identifier"
        },
        "failure_path": {
          "$ref": "#/$defs/Pointer"
        },
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/runtime_ChoiceInput"
          },
          "maxItems": 512,
          "type": "array"
        },
        "next_stage_id": {
          "$ref": "#/$defs/Identifier"
        },
        "observation": {
          "$ref": "#/$defs/runtime_Observation"
        },
        "route": {
          "enum": [
            "branch",
            "default",
            "on_unknown",
            "on_error",
            "failed"
          ]
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "const": "choice-decision/1"
        },
        "selection": {
          "enum": [
            "exclusive",
            "first_match"
          ]
        },
        "stage_activation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "stage_id": {
          "$ref": "#/$defs/Identifier"
        },
        "workflow_invocation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "workflow_ref": {
          "$ref": "#/$defs/flow_Ref"
        }
      },
      "required": [
        "evaluations",
        "id",
        "inputs",
        "observation",
        "route",
        "run_id",
        "schema_version",
        "selection",
        "stage_activation_id",
        "stage_id",
        "workflow_invocation_id",
        "workflow_ref"
      ],
      "type": "object"
    },
    "runtime_ChoiceEvaluation": {
      "additionalProperties": false,
      "properties": {
        "branch_id": {
          "$ref": "#/$defs/Identifier"
        },
        "result": {
          "enum": [
            "true",
            "false",
            "unknown",
            "error",
            "not_evaluated"
          ]
        }
      },
      "required": [
        "branch_id",
        "result"
      ],
      "type": "object"
    },
    "runtime_ChoiceInput": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "availability": {
            "const": "present"
          }
        }
      },
      "properties": {
        "availability": {
          "enum": [
            "present",
            "absent",
            "unavailable"
          ]
        },
        "field_ref": {
          "$ref": "#/$defs/flow_FieldRef"
        },
        "producer_activation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "source_ref": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "availability",
        "field_ref"
      ],
      "then": {
        "required": [
          "source_ref"
        ]
      },
      "type": "object"
    },
    "runtime_Observation": {
      "additionalProperties": false,
      "properties": {
        "monotonic_ms": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/Identifier"
        },
        "source": {
          "type": "string"
        },
        "suspend_basis": {
          "type": "string"
        },
        "utc": {
          "$ref": "#/$defs/Timestamp"
        },
        "utc_trust": {
          "type": "string"
        }
      },
      "required": [
        "monotonic_ms",
        "session",
        "source",
        "suspend_basis",
        "utc",
        "utc_trust"
      ],
      "type": "object"
    }
  },
  "$id": "urn:prifly:choice-decision:1",
  "$ref": "#/$defs/ChoiceDecision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Core decision event payload with ordered branch trace and exact input references. Route/activation ownership and atomic commit are enforced by the runtime.",
  "title": "Pri-Fly choice decision",
  "x-prifly-contracts": [
    "ChoiceDecision"
  ]
}
