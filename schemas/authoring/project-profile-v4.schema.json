{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prifly:yaml-authoring:project-profile:4",
  "title": "Pri-Fly project profile v4",
  "description": "Project profile с явным шаблоном disposable worktree; наследует /3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packages",
    "launches"
  ],
  "properties": {
    "schema_version": {
      "const": "prifly-project-profile/4"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex-cli": {
          "const": ".codex/skills"
        },
        "codex-app": {
          "const": ".agents/skills"
        },
        "claude-code": {
          "const": ".claude/skills"
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "path",
              "ref",
              "commit",
              "digest"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "extend_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "catalog": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "launches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "kind",
          "workflow"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "workflow"
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "workspace": {
            "enum": [
              "worktree",
              "checkout"
            ]
          },
          "preflight": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable",
              "timeout_ms"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeout_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              }
            }
          }
        }
      }
    },
    "worktree_naming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template",
        "bindings"
      ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?:[a-z0-9-]|\\{[a-z][a-z0-9_]{0,31}\\})+$"
        },
        "bindings": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value"
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "input",
                  "pointer"
                ],
                "properties": {
                  "input": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pointer": {
                    "type": "string",
                    "pattern": "^(?:/(?:[^~]|~[01])*)*$"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
