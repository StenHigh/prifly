{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prifly:yaml-authoring:project-profile:3",
  "title": "Pri-Fly project profile v3",
  "description": "Нейтральный Project profile: Git необязателен, hosts добавляются явно только для работы с ИИ.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packages", "launches"],
  "properties": {
    "schema_version": {"const": "prifly-project-profile/3"},
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex-cli": {"const": ".codex/skills"},
        "codex-app": {"const": ".agents/skills"},
        "claude-code": {"const": ".claude/skills"}
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "path", "ref", "commit", "digest"],
            "properties": {
              "repository": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "ref": {"type": "string", "minLength": 1},
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "extend_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "catalog": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "launches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "description", "kind", "workflow"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "kind": {"const": "workflow"},
          "workflow": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
