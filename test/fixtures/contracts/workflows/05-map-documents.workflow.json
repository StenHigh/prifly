{
  "schema_version": "1",
  "id": "example:workflow/map-documents",
  "version": "1.0.0",
  "title": "05. Sealed collection, stable keys, explicit empty path",
  "inputs": {
    "documents": {
      "format": "json",
      "schema_ref": {
        "id": "example:schema/documents",
        "version": "1.0.0",
        "digest": "sha256:0d28d4d77cc1aaedfa967c3346e333631599f5f3355b9c47cd33a94314a4c883"
      },
      "required": true
    }
  },
  "outputs": {
    "results": {
      "format": "json",
      "schema_ref": {
        "id": "prifly:core/schema/AggregateManifest",
        "version": "1.0.0",
        "digest": "sha256:fe27e444a4e844a93e03366d135cb275bf412e3985d44ce92be1944c5d3a7bab"
      },
      "required_for": [
        "succeeded",
        "rejected",
        "no_work"
      ]
    }
  },
  "allowed_outcomes": [
    "succeeded",
    "rejected",
    "no_work"
  ],
  "definition": {
    "entry": "checks",
    "stages": {
      "checks": {
        "kind": "map",
        "items": {
          "from": "workflow_input",
          "port": "documents"
        },
        "body_workflow_ref": {
          "id": "example:workflow/document-check-child",
          "version": "1.0.0",
          "digest": "sha256:4a0ae6972603af3678be5b9ae3c45384f6e700c4e134e3f8f64fbfc5519f42ec"
        },
        "item_input": "document",
        "item_key_pointer": "/key",
        "input_bindings": {},
        "max_items": 32,
        "max_parallelism": 4,
        "join": {
          "mode": "all",
          "accept_outcomes": [
            "succeeded"
          ],
          "selection": "all",
          "remainder": "wait"
        },
        "on": {
          "satisfied": "done",
          "unsatisfied": "rejected",
          "empty": "empty"
        }
      },
      "done": {
        "kind": "finish",
        "outcome": "succeeded",
        "output_bindings": {
          "results": {
            "from": "stage_output",
            "stage_id": "checks",
            "port": "results"
          }
        }
      },
      "rejected": {
        "kind": "finish",
        "outcome": "rejected",
        "output_bindings": {
          "results": {
            "from": "stage_output",
            "stage_id": "checks",
            "port": "results"
          }
        }
      },
      "empty": {
        "kind": "finish",
        "outcome": "no_work",
        "output_bindings": {
          "results": {
            "from": "stage_output",
            "stage_id": "checks",
            "port": "results"
          }
        }
      }
    }
  },
  "limits": {
    "max_step_instances": 10000,
    "max_control_transitions": 100000,
    "max_parallelism": 4,
    "max_child_depth": 8
  },
  "policy_ref": {
    "id": "example:policy/local",
    "version": "1.0.0",
    "digest": "sha256:395ef7427c2922e1a90017ef471524ecc837336bae78d71d9f7320f1f1a42125"
  }
}
