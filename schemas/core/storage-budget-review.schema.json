{
  "$defs": {
    "StorageBudgetReview": {
      "$ref": "#/$defs/runtime_StorageBudgetReview"
    },
    "local_AuthorityStorageBudget": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "authority_id": {
          "type": "string"
        },
        "bootstrap_storage_version": {
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "command_id": {
          "type": "string"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "limit_bytes": {
          "maximum": 68719476736,
          "minimum": 65536,
          "type": "integer"
        },
        "observed_allocated_bytes": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "previous_limit_bytes": {
          "maximum": 68719476736,
          "minimum": 65536,
          "type": "integer"
        },
        "reason": {
          "type": "string"
        },
        "schema_version": {
          "const": "authority-storage-budget/1"
        },
        "source": {
          "enum": [
            "default",
            "legacy_default",
            "bootstrap",
            "owner"
          ]
        }
      },
      "required": [
        "actor",
        "authority_id",
        "bootstrap_storage_version",
        "command_id",
        "epoch",
        "generation",
        "limit_bytes",
        "observed_allocated_bytes",
        "previous_limit_bytes",
        "reason",
        "schema_version",
        "source"
      ],
      "type": "object"
    },
    "local_StorageUsage": {
      "additionalProperties": false,
      "properties": {
        "allocated_bytes": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "free_pages": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "page_count": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "page_size": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "soft_limit_bytes": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        }
      },
      "required": [
        "allocated_bytes",
        "free_pages",
        "page_count",
        "page_size",
        "soft_limit_bytes"
      ],
      "type": "object"
    },
    "runtime_StorageBudgetReview": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string"
        },
        "review_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "schema_version": {
          "const": "storage-budget-review/1"
        },
        "status": {
          "$ref": "#/$defs/runtime_StorageBudgetStatus"
        },
        "storage_from_version": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "storage_to_version": {
          "const": 10
        },
        "target_bytes": {
          "maximum": 68719476736,
          "minimum": 65536,
          "type": "integer"
        }
      },
      "required": [
        "reason",
        "review_digest",
        "schema_version",
        "status",
        "storage_from_version",
        "storage_to_version",
        "target_bytes"
      ],
      "type": "object"
    },
    "runtime_StorageBudgetStatus": {
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "type": "string"
        },
        "control": {
          "anyOf": [
            {
              "$ref": "#/$defs/local_AuthorityStorageBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "cut": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "epoch": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "measurement": {
          "enum": [
            "known",
            "unknown"
          ]
        },
        "reason": {
          "type": "string"
        },
        "safe_next_actions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "storage-budget-status/1"
        },
        "storage_version": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/local_StorageUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authority_id",
        "control",
        "cut",
        "epoch",
        "measurement",
        "reason",
        "safe_next_actions",
        "schema_version",
        "storage_version",
        "usage"
      ],
      "type": "object"
    }
  },
  "$id": "urn:prifly:storage-budget-review:1",
  "$ref": "#/$defs/StorageBudgetReview",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-prifly-contracts": [
    "StorageBudgetReview"
  ]
}
