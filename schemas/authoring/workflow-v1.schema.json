{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prifly:yaml-authoring:workflow:1",
  "title": "Pri-Fly workflow authoring",
  "type": "object",
  "additionalProperties": false,
  "required": ["authoring", "id", "version", "entry", "stages", "limits", "policy_ref"],
  "properties": {
    "authoring": {"const": "prifly-workflow/1"},
    "schema_version": {"type": "string", "minLength": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "number"]},
    "title": {"type": "string", "minLength": 1},
    "refs": {"type": "object", "additionalProperties": {}},
    "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/port"}},
    "outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/port"}},
    "features": {"$ref": "#/$defs/features"},
    "allowed_outcomes": {"type": "array", "items": {"type": "string"}},
    "entry": {"type": "string", "minLength": 1},
    "stages": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/stage"}},
    "limits": {"$ref": "#/$defs/limits"},
    "policy_ref": {"$ref": "#/$defs/reference"},
    "checkpoint": {
      "description": "Revision 7: the schema of the point this workflow's work can be continued from. A step stage names the output reporting it with `checkpoint: PORT`.",
      "type": "object", "additionalProperties": false, "required": ["schema_ref"],
      "properties": {"schema_ref": {"$ref": "#/$defs/reference"}}
    },
    "continuation": {
      "description": "Revision 7: which finished Runs this workflow continues and where each input comes from in them.",
      "type": "object", "additionalProperties": false, "required": ["from_workflows", "inputs"],
      "anyOf": [{"required": ["from_outcomes"]}, {"required": ["from_cancelled"]}],
      "properties": {
        "from_workflows": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "from_outcomes": {"type": "array", "items": {"enum": ["succeeded", "rejected", "no_work", "partial", "completed_with_waivers"]}, "minItems": 1, "uniqueItems": true},
        "from_cancelled": {"const": true, "description": "Also continue a cancelled Run: it has no outcome, and its accepted steps and tree are what it leaves."},
        "inputs": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["source_input"], "properties": {"source_input": {"type": "string", "minLength": 1}}},
            {"type": "object", "additionalProperties": false, "required": ["stage", "output", "verdict"], "properties": {"stage": {"type": "string", "minLength": 1}, "output": {"type": "string", "minLength": 1}, "verdict": {"enum": ["pass", "fail", "needs_revision", "no_work", "blocked"]}}},
            {"type": "object", "additionalProperties": false, "required": ["stage", "output", "outcome"], "properties": {"stage": {"type": "string", "minLength": 1}, "output": {"type": "string", "minLength": 1}, "outcome": {"enum": ["succeeded", "rejected", "no_work", "partial", "completed_with_waivers"]}}},
            {"type": "object", "additionalProperties": false, "required": ["checkpoint"], "properties": {"checkpoint": {"const": true}}}
          ]}
        }
      }
    }
  },
  "$defs": {
    "reference": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "object"}]},
    "port": {"anyOf": [{"$ref": "#/$defs/reference"}, {"type": "object", "additionalProperties": true}]},
    "features": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input"],
        "properties": {"input": {"type": "string", "minLength": 1}}
      }
    },
    "stage": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"enum": ["step", "call", "choice", "repeat", "parallel", "map", "wait", "finish"]}},
      "additionalProperties": true
    },
    "limits": {
      "type": "object",
      "required": ["max_step_instances", "max_control_transitions"],
      "properties": {
        "max_step_instances": {"type": "integer", "minimum": 1},
        "max_control_transitions": {"type": "integer", "minimum": 1},
        "max_parallelism": {"type": "integer", "minimum": 1},
        "max_child_depth": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
