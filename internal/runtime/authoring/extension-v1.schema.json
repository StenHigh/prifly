{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prifly:yaml-authoring:extension:1",
  "title": "Pri-Fly workflow extensions",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "decision_policy": {"enum": ["attended", "autonomous"]},
        "preflight": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
          "additionalProperties": true
        },
        "runtime": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
          "additionalProperties": true
        }
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": true
      }
    },
    "execution_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
          "additionalProperties": {
            "type": "object",
            "required": ["executable", "timeout_ms", "grace_ms", "max_output_bytes"],
            "additionalProperties": false,
            "properties": {
              "executable": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
              "args": {"type": "array", "items": {"type": "string"}},
              "files": {"type": "object", "additionalProperties": {"type": "string"}},
              "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
              "grace_ms": {"type": "integer", "minimum": 1, "maximum": 5000},
              "max_output_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
              "context_profile_ref": {"type": "object"}
            }
          }
        }
      }
    },
    "exclude": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "workflow", "between", "step", "on"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "workflow": {"type": "string", "minLength": 1},
          "between": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1}
            }
          },
          "step": {"type": "string", "minLength": 1},
          "on": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
          "impossible_verdicts": {
            "type": "array",
            "items": {"enum": ["pass", "fail", "needs_revision", "no_work"]},
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "input_bindings": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
            "additionalProperties": {"type": "string", "pattern": "^\\$stages\\.[^.]+\\..+$"}
          }
        }
      }
    }
  }
}
