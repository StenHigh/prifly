{
  "schema_version": "1",
  "id": "example:workflow/research-brief",
  "version": "1.0.0",
  "title": "02. Explicit AI work within one step, from supplied sources only",
  "inputs": {
    "question": {
      "format": "json",
      "schema_ref": {
        "id": "example:schema/string",
        "version": "1.0.0",
        "digest": "sha256:d896d4361ee08a6874a2a06dbaac844b460ecf369617d2f565f43db443946665"
      },
      "required": true
    },
    "sources": {
      "format": "json",
      "schema_ref": {
        "id": "example:schema/documents",
        "version": "1.0.0",
        "digest": "sha256:0d28d4d77cc1aaedfa967c3346e333631599f5f3355b9c47cd33a94314a4c883"
      },
      "required": true
    }
  },
  "outputs": {
    "brief": {
      "format": "json",
      "schema_ref": {
        "id": "example:schema/brief",
        "version": "1.0.0",
        "digest": "sha256:f641d42150e565e9cb9aec589ffc8c8ce6674e9fe615859c38f202da58518f36"
      },
      "required_for": [
        "succeeded"
      ]
    }
  },
  "allowed_outcomes": [
    "succeeded",
    "rejected"
  ],
  "definition": {
    "entry": "research",
    "stages": {
      "research": {
        "kind": "step",
        "step_ref": {
          "id": "example:step/write-brief",
          "version": "1.0.0",
          "digest": "sha256:cc89d14d618396538d77d6f673dd2dc996861f93fef4c52bfbbbe15d6440ca8e"
        },
        "input_bindings": {
          "question": {
            "from": "workflow_input",
            "port": "question"
          },
          "sources": {
            "from": "workflow_input",
            "port": "sources"
          }
        },
        "on": {
          "pass": "done",
          "fail": "rejected"
        }
      },
      "done": {
        "kind": "finish",
        "outcome": "succeeded",
        "output_bindings": {
          "brief": {
            "from": "stage_output",
            "stage_id": "research",
            "port": "brief"
          }
        }
      },
      "rejected": {
        "kind": "finish",
        "outcome": "rejected",
        "output_bindings": {}
      }
    }
  },
  "limits": {
    "max_step_instances": 10000,
    "max_control_transitions": 100000,
    "max_parallelism": 4,
    "max_child_depth": 8
  },
  "policy_ref": {
    "id": "example:policy/local",
    "version": "1.0.0",
    "digest": "sha256:395ef7427c2922e1a90017ef471524ecc837336bae78d71d9f7320f1f1a42125"
  }
}
